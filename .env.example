# ─── Anthropic ───────────────────────────────────────────────────────────────
# API key from console.anthropic.com/api-keys (used by the Audit Bot)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Site ────────────────────────────────────────────────────────────────────
# Full origin, no trailing slash. Used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=https://abdulwahabai.com

# ─── Cal.com ─────────────────────────────────────────────────────────────────
# The slug that appears in your Cal.com booking link, e.g. "abdulwahab/30min"
NEXT_PUBLIC_CAL_LINK=abdulwahab/30min

# ─── Resend (email) ──────────────────────────────────────────────────────────
# API key from resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Verified sending address (must match a domain verified in Resend — NOT a Gmail address)
RESEND_FROM_ADDRESS=info@abdulwahabai.com

# ─── Inbox routing ───────────────────────────────────────────────────────────
# Destination addresses for each form. All default to owner email if unset.
CONTACT_INBOX=info@abdulwahabai.com
AUDIT_INBOX=info@abdulwahabai.com
WORKSHOP_INBOX=info@abdulwahabai.com
SESSIONS_INBOX=info@abdulwahabai.com
LAB_INBOX=info@abdulwahabai.com

# ─── hCaptcha ────────────────────────────────────────────────────────────────
# Secret key from hcaptcha.com (server-side verification only, never public)
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# ─── Upstash Redis (rate limiting) ───────────────────────────────────────────
# Leave blank in local dev to disable rate limiting (safe — falls back gracefully)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Mux (video) ─────────────────────────────────────────────────────────────
# Playback ID for the About page video greeting (Urdu intro)
NEXT_PUBLIC_MUX_PLAYBACK_ID=

# ─── Plausible Analytics ─────────────────────────────────────────────────────
# Your site domain as registered in Plausible, e.g. "abdulwahabai.com"
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=abdulwahabai.com

# ─── Google Analytics (supplemental to Plausible) ───────────────────────────
# GA4 measurement ID, e.g. "G-4EXF97Y9H9"
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ─── Microsoft Clarity (session recordings + heatmaps) ──────────────────────
# Clarity project ID from clarity.microsoft.com, e.g. "y244d1y1vs"
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ─── Build flags ─────────────────────────────────────────────────────────────
# Set to "true" to open the bundle analyzer after build (local only)
ANALYZE=false
